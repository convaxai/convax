{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "convax",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "bun turbo dev --filter=@convax/desktop",
    "dev:desktop": "bun --cwd packages/desktop dev",
    "build": "bun turbo build",
    "typecheck": "bun turbo typecheck",
    "test": "echo 'run tests from package directories' && exit 1"
  },
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalog": {
      "@radix-ui/react-context-menu": "2.3.3",
      "@radix-ui/react-tooltip": "1.2.12",
      "@tailwindcss/vite": "4.3.2",
      "@types/bun": "1.3.14",
      "@types/node": "24.12.2",
      "@types/react": "19.2.17",
      "@types/react-dom": "19.2.3",
      "@vitejs/plugin-react": "5.2.0",
      "@xyflow/react": "12.11.2",
      "class-variance-authority": "0.7.1",
      "clsx": "2.1.1",
      "electron": "42.3.3",
      "electron-vite": "5.0.0",
      "lucide-react": "1.24.0",
      "react": "19.2.7",
      "react-dom": "19.2.7",
      "tailwind-merge": "3.6.0",
      "tailwindcss": "4.3.2",
      "typescript": "5.8.2",
      "vite": "7.1.4"
    }
  },
  "devDependencies": {
    "turbo": "2.10.2"
  },
  "trustedDependencies": [
    "electron",
    "esbuild"
  ],
  "prettier": {
    "semi": false,
    "printWidth": 120
  }
}
