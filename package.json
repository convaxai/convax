{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "convax",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "bun turbo dev --filter=@convax/desktop",
    "dev:desktop": "bun turbo dev --filter=@convax/desktop",
    "dev:docs": "bun turbo dev --filter=@convax/docs",
    "dev:web": "bun turbo dev --filter=@convax/web",
    "dev:cloudflare": "bun turbo dev --filter=@convax/deploy-cloudflare",
    "build": "bun turbo build",
    "deploy:cloudflare": "bun run --cwd apps/deploy-cloudflare deploy",
    "package": "bun run --cwd packages/desktop package",
    "package:dir": "bun run --cwd packages/desktop package:dir",
    "package:mac": "bun run --cwd packages/desktop package:mac",
    "package:win": "bun run --cwd packages/desktop package:win",
    "package:linux": "bun run --cwd packages/desktop package:linux",
    "smoke:packaged": "bun run --cwd packages/desktop smoke:packaged",
    "marketplace:configure": "bun scripts/marketplace-product-lock-configure.ts",
    "marketplace:lock": "bun scripts/marketplace-product-lock-resolve.ts",
    "marketplace:verify": "bun scripts/marketplace-product-lock.ts",
    "format": "prettier --ignore-unknown --write .",
    "lint": "oxlint",
    "typecheck": "bun turbo typecheck",
    "test": "bun turbo test",
    "package:boundaries": "bun scripts/package-boundary-check.ts",
    "plugin-api:history-policy": "bun scripts/plugin-api-history-policy.ts",
    "pack:check": "bun run package:boundaries && bun scripts/package-pack-smoke.ts",
    "check": "bun run lint && bun run typecheck && bun run test && bun run pack:check && bun --cwd packages/desktop smoke:open-project",
    "prepare": "husky"
  },
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@radix-ui/react-context-menu": "2.3.4",
      "@radix-ui/react-menu": "2.1.21",
      "@noble/hashes": "2.2.0",
      "@tailwindcss/vite": "4.3.2",
      "@tiptap/core": "3.29.2",
      "@tiptap/extension-collaboration": "3.29.2",
      "@tiptap/extension-drag-handle": "3.29.2",
      "@tiptap/extension-drag-handle-react": "3.29.2",
      "@tiptap/extension-mention": "3.29.2",
      "@tiptap/extension-node-range": "3.29.2",
      "@tiptap/extension-placeholder": "3.29.2",
      "@tiptap/extension-table": "3.29.2",
      "@tiptap/extension-text-align": "3.29.2",
      "@tiptap/markdown": "3.29.2",
      "@tiptap/react": "3.29.2",
      "@tiptap/starter-kit": "3.29.2",
      "@tiptap/suggestion": "3.29.2",
      "@typescript/native-preview": "7.0.0-dev.20251207.1",
      "@types/bun": "1.3.14",
      "@types/node": "24.12.2",
      "@types/react": "19.2.17",
      "@types/react-dom": "19.2.3",
      "@vitejs/plugin-react": "5.2.0",
      "@xyflow/react": "12.11.2",
      "class-variance-authority": "0.7.1",
      "clsx": "2.1.1",
      "electron": "42.4.1",
      "electron-builder": "26.15.2",
      "electron-vite": "5.0.0",
      "happy-dom": "20.11.0",
      "lucide-react": "1.24.0",
      "peerjs": "1.5.5",
      "react": "19.2.7",
      "react-dom": "19.2.7",
      "tailwind-merge": "3.6.0",
      "tailwindcss": "4.3.2",
      "typescript": "5.8.2",
      "vite": "7.1.4",
      "yjs": "13.6.31"
    }
  },
  "devDependencies": {
    "@typescript/native-preview": "catalog:",
    "husky": "9.1.7",
    "oxlint": "1.60.0",
    "oxlint-tsgolint": "0.21.0",
    "prettier": "3.6.2",
    "turbo": "2.10.2"
  },
  "trustedDependencies": [
    "electron",
    "esbuild",
    "opencode-ai"
  ],
  "prettier": {
    "semi": false,
    "printWidth": 120
  }
}
