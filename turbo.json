{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"]
    },
    "@convax/desktop#dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"],
      "env": [
        "CONVAX_FEATURE_SERVICES",
        "CONVAX_FEATURE_SKILLS_AND_PLUGINS",
        "CONVAX_OFFICIAL_MARKETPLACE_ARTIFACT_ROOT"
      ]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "out/**"]
    },
    "@convax/desktop#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "out/**"],
      "env": ["CONVAX_FEATURE_SERVICES", "CONVAX_FEATURE_SKILLS_AND_PLUGINS"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "@convax/desktop#test": {
      "dependsOn": ["build"],
      "env": ["CONVAX_DESKTOP_TEST_SHARD"],
      "outputs": []
    }
  }
}
