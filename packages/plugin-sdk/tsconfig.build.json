{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "baseUrl": ".",
    "paths": {
      "@convax/bounded-value": ["../bounded-value/dist/index.d.ts"],
      "@convax/plugin-api": ["../plugin-api/dist/index.d.ts"],
      "@convax/plugin-api/*": ["../plugin-api/dist/*"]
    },
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts"]
}
