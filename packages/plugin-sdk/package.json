{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@convax/plugin-sdk",
  "version": "0.3.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/convaxai/convax.git",
    "directory": "packages/plugin-sdk"
  },
  "engines": {
    "node": ">=20.0.0",
    "bun": ">=1.3.0"
  },
  "packageManager": "bun@1.3.14",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    },
    "./pet": {
      "types": "./dist/pet.d.ts",
      "import": "./dist/pet.js",
      "default": "./dist/pet.js"
    },
    "./pet-client": {
      "types": "./dist/pet-client.d.ts",
      "import": "./dist/pet-client.js",
      "default": "./dist/pet-client.js"
    }
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build:js": "bun scripts/build-js.ts",
    "build:types": "tsc -p tsconfig.build.json",
    "build": "bun run typecheck && bun run clean && bun run build:js && bun run build:types",
    "test": "bun test",
    "typecheck": "tsgo --noEmit",
    "pack:check": "bun run build && bun scripts/pack-check.ts",
    "prepack": "bun run build",
    "prepublishOnly": "bun run typecheck && bun run test"
  },
  "dependencies": {
    "@convax/bounded-value": "workspace:^",
    "@convax/plugin-api": "workspace:^"
  },
  "devDependencies": {
    "@typescript/native-preview": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
