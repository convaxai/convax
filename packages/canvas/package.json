{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@convax/canvas",
  "version": "0.5.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./application": {
      "types": "./dist/application/index.d.ts",
      "import": "./dist/application/index.js",
      "default": "./dist/application/index.js"
    },
    "./application/errors": {
      "types": "./dist/application/errors.d.ts",
      "import": "./dist/application/errors.js",
      "default": "./dist/application/errors.js"
    },
    "./collaboration": {
      "types": "./dist/collaboration/index.d.ts",
      "import": "./dist/collaboration/index.js",
      "default": "./dist/collaboration/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js",
      "default": "./dist/core.js"
    },
    "./styles.css": "./dist/styles.css",
    "./view": {
      "types": "./dist/view.d.ts",
      "import": "./dist/view.js",
      "default": "./dist/view.js"
    }
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build:js": "for entry in src/index.ts src/application/index.ts src/application/errors.ts src/collaboration/index.ts src/core.ts src/view.ts; do bun build --production --keep-names --target=browser --format=esm --packages=external --external='@convax/*' --sourcemap=linked --root=src --outdir=dist \"$entry\"; done",
    "build:css": "bun scripts/build-css.ts",
    "build:types": "tsc -p tsconfig.build.json",
    "build": "bun run typecheck && bun run clean && bun run build:js && bun run build:css && bun run build:types",
    "test": "bun run test:unit && bun run test:generation-panel && bun run test:react-flow-integration",
    "test:unit": "bun test --isolate --parallel=1 --path-ignore-patterns='**/canvas-editor-box-selection.test.tsx' --path-ignore-patterns='**/canvas-generation-panel.test.tsx'",
    "test:generation-panel": "bun test --isolate --parallel=1 src/components/canvas-generation-panel.test.tsx",
    "test:react-flow-integration": "bun test --isolate --parallel=1 src/components/canvas-editor-box-selection.test.tsx",
    "typecheck": "tsgo --noEmit",
    "prepack": "bun run build",
    "prepublishOnly": "bun run typecheck && bun run test"
  },
  "dependencies": {
    "@convax/bounded-value": "workspace:^",
    "@convax/collaboration": "workspace:^",
    "@convax/uri": "workspace:^",
    "@convax/ui": "workspace:^",
    "@tiptap/core": "catalog:",
    "@tiptap/extension-drag-handle-react": "catalog:",
    "@tiptap/extension-mention": "catalog:",
    "@tiptap/extension-placeholder": "catalog:",
    "@tiptap/extension-table": "catalog:",
    "@tiptap/extension-text-align": "catalog:",
    "@tiptap/markdown": "catalog:",
    "@tiptap/react": "catalog:",
    "@tiptap/starter-kit": "catalog:",
    "@tiptap/suggestion": "catalog:",
    "@xyflow/react": "catalog:",
    "lucide-react": "catalog:",
    "yjs": "catalog:"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "catalog:",
    "@typescript/native-preview": "catalog:",
    "@types/bun": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "happy-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
