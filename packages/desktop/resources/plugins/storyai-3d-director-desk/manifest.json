{
  "schema": "convax.plugin/1",
  "id": "storyai-3d-director-desk",
  "name": "3D Director Desk",
  "description": "An open-source browser-based 3D blocking surface for characters, props, cameras, panoramas, and shot previews.",
  "version": "0.0.1-convax.3",
  "entry": "index.html",
  "capabilities": ["canvas.node.write", "canvas.image.write"],
  "contributes": {
    "canvas": {
      "renderer": {
        "create": true,
        "width": 1100,
        "height": 700
      },
      "toolbar": [
        {
          "id": "play",
          "title": "关联当前帧",
          "command": "scene.play",
          "icon": "play"
        }
      ]
    }
  },
  "skill": "SKILL.md"
}
