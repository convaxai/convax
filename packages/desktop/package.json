{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@convax/desktop",
  "productName": "Convax",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "bun scripts/ensure-electron-runtime.ts && electron-vite dev",
    "build": "electron-vite build",
    "smoke:open-project": "bun scripts/ensure-electron-runtime.ts && bun run build && bun ../../scripts/desktop-open-project-built-smoke.ts",
    "test": "bun test",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@convax/agent-runtime": "workspace:*",
    "@convax/canvas": "workspace:*",
    "@convax/project": "workspace:*",
    "@convax/project-files": "workspace:*",
    "@convax/ui": "workspace:*",
    "@convax/workbench": "workspace:*",
    "lucide-react": "catalog:",
    "marked": "17.0.6",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@typescript/native-preview": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "electron": "catalog:",
    "electron-vite": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "tailwindcss": "catalog:"
  }
}
