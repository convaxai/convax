{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@convax/desktop",
  "productName": "Convax",
  "description": "A desktop visual workspace for connected canvases, projects, plugins, and AI-assisted work.",
  "author": "Convax contributors",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./out/main/index.cjs",
  "scripts": {
    "build:workspace-dependencies": "bun scripts/ensure-workspace-dependencies.ts",
    "collaboration:prepare": "bun scripts/stage-collaboration-protocol.ts",
    "dev": "bun run build:workspace-dependencies && bun run collaboration:prepare && bun scripts/ensure-electron-runtime.ts && electron-vite dev",
    "build": "bun run build:workspace-dependencies && bun run collaboration:prepare && electron-vite build",
    "package:prepare": "bun run build && bun scripts/ensure-electron-runtime.ts && bun scripts/stage-packaged-runtime.ts",
    "package": "bun run package:prepare && electron-builder --config electron-builder.config.ts",
    "package:dir": "bun run package:prepare && electron-builder --config electron-builder.config.ts --dir",
    "package:mac": "bun run package:prepare && electron-builder --config electron-builder.config.ts --mac",
    "package:win": "bun run package:prepare && electron-builder --config electron-builder.config.ts --win",
    "package:linux": "bun run package:prepare && electron-builder --config electron-builder.config.ts --linux",
    "smoke:packaged": "bun run package:dir && bun scripts/desktop-packaged-smoke.ts",
    "smoke:offline-restart": "bun scripts/ensure-electron-runtime.ts && bun run build && bun ../../scripts/desktop-offline-restart-smoke.ts",
    "smoke:open-project": "bun scripts/ensure-electron-runtime.ts && bun run build && bun ../../scripts/desktop-open-project-built-smoke.ts",
    "probe:peerjs-main": "bun scripts/peerjs-electron-main-probe.ts",
    "test": "bun scripts/desktop-test-suite.ts",
    "typecheck": "tsgo --noEmit",
    "benchmark:project-index-durable": "bun scripts/project-index-durable-benchmark.ts",
    "benchmark:project-index-durable:full": "CONVAX_BENCH_FULL=1 bun scripts/project-index-durable-benchmark.ts"
  },
  "dependencies": {
    "@convax/agent-runtime": "workspace:*",
    "@convax/canvas": "workspace:*",
    "@convax/collaboration": "workspace:*",
    "@convax/marketplace": "workspace:*",
    "@convax/plugin-api": "workspace:*",
    "@convax/plugin-sdk": "workspace:*",
    "@convax/project": "workspace:*",
    "@convax/project-files": "workspace:*",
    "@convax/uri": "workspace:*",
    "@convax/ui": "workspace:*",
    "@convax/workbench": "workspace:*",
    "acorn": "8.17.0",
    "builder-util-runtime": "9.7.0",
    "electron-updater": "6.8.9",
    "i18next": "26.3.6",
    "lucide-react": "catalog:",
    "marked": "17.0.6",
    "peerjs": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-i18next": "17.0.11"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@typescript/native-preview": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "electron": "catalog:",
    "electron-builder": "catalog:",
    "electron-vite": "catalog:",
    "happy-dom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "tailwindcss": "catalog:"
  }
}
