{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@convax/project",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "import": "./dist/contracts.js",
      "default": "./dist/contracts.js"
    },
    "./canvas": {
      "types": "./dist/canvas/index.d.ts",
      "import": "./dist/canvas/index.js",
      "default": "./dist/canvas/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.js",
      "default": "./dist/node/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build:browser": "for entry in src/index.ts src/contracts.ts src/canvas/index.ts; do bun build --production --keep-names --target=browser --format=esm --packages=external --external='@convax/*' --sourcemap=linked --root=src --outdir=dist \"$entry\"; done",
    "build:node": "bun build --production --keep-names --target=node --format=esm --packages=external --external='@convax/*' --sourcemap=linked --root=src --outdir=dist src/node/index.ts",
    "build:css": "bun scripts/build-css.ts",
    "build:types": "tsc -p tsconfig.build.json",
    "build": "bun run typecheck && bun run clean && bun run build:browser && bun run build:node && bun run build:css && bun run build:types",
    "test": "bun test",
    "typecheck": "tsgo --noEmit",
    "prepack": "bun run build",
    "prepublishOnly": "bun run typecheck && bun run test"
  },
  "dependencies": {
    "@convax/canvas": "workspace:^",
    "@convax/project-files": "workspace:^",
    "@convax/ui": "workspace:^",
    "lucide-react": "catalog:"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "catalog:",
    "@typescript/native-preview": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "happy-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
