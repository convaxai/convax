{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "baseUrl": ".",
    "paths": {
      "@convax/marketplace": ["../marketplace/dist/index.d.ts"],
      "@convax/marketplace/*": ["../marketplace/dist/*"],
      "@convax/plugin-api": ["../plugin-api/dist/index.d.ts"],
      "@convax/plugin-api/*": ["../plugin-api/dist/*"],
      "@convax/plugin-sdk": ["../plugin-sdk/dist/index.d.ts"],
      "@convax/plugin-sdk/*": ["../plugin-sdk/dist/*"]
    },
    "rootDir": "src",
    "outDir": "dist"
  },
  "exclude": ["src/**/*.test.ts"]
}
