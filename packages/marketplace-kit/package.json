{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@convax/marketplace-kit",
  "version": "0.2.2",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/convaxai/convax.git",
    "directory": "packages/marketplace-kit"
  },
  "engines": {
    "node": ">=20.0.0",
    "bun": ">=1.3.0"
  },
  "packageManager": "bun@1.3.14",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "convax-marketplace": "./dist/cli.js"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js",
      "default": "./dist/cli.js"
    }
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build:js": "bun build --production --keep-names --target=node --format=esm --packages=external --external='@convax/*' --sourcemap=linked --root=src --outdir=dist src/index.ts src/cli.ts",
    "build:types": "tsc -p tsconfig.build.json",
    "build": "bun run typecheck && bun run clean && bun run build:js && bun run build:types",
    "test": "bun test --timeout 20000",
    "typecheck": "tsgo --noEmit",
    "pack:check": "bun run build && bun scripts/pack-check.ts",
    "prepack": "bun run build",
    "prepublishOnly": "bun run typecheck && bun run test"
  },
  "dependencies": {
    "@convax/marketplace": "workspace:^",
    "@convax/plugin-api": "workspace:^",
    "@convax/plugin-sdk": "workspace:^"
  },
  "devDependencies": {
    "@typescript/native-preview": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
