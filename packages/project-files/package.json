{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@convax/project-files",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "import": "./dist/contracts.js",
      "default": "./dist/contracts.js"
    },
    "./drag": {
      "types": "./dist/drag.d.ts",
      "import": "./dist/drag.js",
      "default": "./dist/drag.js"
    },
    "./identity": {
      "types": "./dist/identity.d.ts",
      "import": "./dist/identity.js",
      "default": "./dist/identity.js"
    },
    "./project-uri": {
      "types": "./dist/project-uri.d.ts",
      "import": "./dist/project-uri.js",
      "default": "./dist/project-uri.js"
    }
  },
  "scripts": {
    "clean": "bun scripts/clean.ts",
    "build:browser": "bun scripts/build-browser.ts",
    "build:types": "tsc -p tsconfig.build.json",
    "build": "bun run typecheck && bun run clean && bun run build:browser && bun run build:types",
    "test": "bun test",
    "typecheck": "tsgo --noEmit",
    "prepack": "bun run build",
    "prepublishOnly": "bun run typecheck && bun run test"
  },
  "dependencies": {
    "@convax/uri": "workspace:^"
  },
  "devDependencies": {
    "@typescript/native-preview": "catalog:",
    "@types/bun": "catalog:",
    "typescript": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
