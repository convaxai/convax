{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@convax/uri",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/microvoid/convax.git",
    "directory": "packages/uri"
  },
  "engines": {
    "node": ">=20.0.0",
    "bun": ">=1.3.0"
  },
  "packageManager": "bun@1.3.14",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build:js": "bun build --production --keep-names --target=browser --format=esm --packages=external --sourcemap=linked --root=src --outdir=dist src/index.ts",
    "build:types": "tsc -p tsconfig.build.json",
    "build": "bun run typecheck && bun run clean && bun run build:js && bun run build:types",
    "test": "bun test",
    "typecheck": "tsgo --noEmit",
    "prepack": "bun run build",
    "prepublishOnly": "bun run typecheck && bun run test"
  },
  "devDependencies": {
    "@typescript/native-preview": "catalog:",
    "@types/bun": "catalog:",
    "typescript": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
