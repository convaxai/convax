// Convax 当前 v8 插件平台。
//
// 校验：
//   npx likec4 validate docs/diagrams

specification {
  element actor {
    notation '角色'
    style {
      color gray
      shape person
    }
  }

  element system {
    notation '系统'
    style {
      color blue
    }
  }

  element boundary {
    notation '边界'
    style {
      color muted
    }
  }

  element component {
    notation '组件'
    style {
      color green
    }
  }

  element service {
    notation '服务'
    style {
      color sky
    }
  }

  element artifact {
    notation '制品'
    style {
      color amber
      shape document
    }
  }

  element storage {
    notation '存储'
    style {
      color gray
      shape storage
    }
  }

  element external {
    notation '外部系统'
    style {
      color amber
    }
  }

  deploymentNode device {
    notation '设备'
    style {
      color gray
    }
  }

  deploymentNode process {
    notation '进程'
    style {
      color blue
    }
  }

  deploymentNode sandbox {
    notation '沙箱'
    style {
      color amber
    }
  }

  deploymentNode data {
    notation '数据'
    style {
      color gray
      shape storage
    }
  }

  deploymentNode network {
    notation '网络边界'
    style {
      color muted
    }
  }
}

model {
  user = actor 'Convax 用户' {
    description '安装能力并显式触发 Canvas、Agent、Tool 与服务操作。'
  }

  pluginAuthor = actor '插件作者' {
    description '在独立插件仓库中实现具体 Plugin、Skill、MCP server 与 companion。'
  }

  hostMaintainer = actor 'Host 维护者' {
    description '在人类批准后维护通用 Catalog、SDK、Main handler 与 conformance tests。'
  }

  registry = external '能力 Registry' {
    description '发布 package/2 元数据、版本、target 与不可变 artifact identity。'
  }

  releases = external '不可变 Release 制品' {
    description 'Plugin ZIP、standalone Skill ZIP 与 target-specific managed companion。'
  }

  externalService = external '插件负责的外部服务' {
    description '凭据、网络调用和供应商语义停留在已验证 sidecar 或 native remote MCP 边界。'
  }

  pluginSource = system '独立插件源码仓库' {
    description '具体集成唯一源码所有者；发现缺失 Host API 时只能提交结构化请求。'

    package = artifact 'v8 Plugin package' {
      description '唯一 convax.plugin/8 Manifest、静态资源和声明式 contributions。'
    }

    hostRequest = artifact 'Plugin-to-Host change request' {
      description 'Use case、通用 contract、替代方案、authority、side effect 与可证伪测试。'
    }

    generatedSkill = artifact 'Plugin authoring Skill reference' {
      description '从 Host API Catalog 与 SDK contract 确定性生成，不手写 API 列表。'
    }
  }

  pluginRuntime = system '已安装 Plugin 完整闭包' {
    description '一个 content-addressed immutable snapshot；各贡献不相互继承权限。'

    manifest = artifact 'convax.plugin/8 Manifest' {
      description '身份、Host API declaration、P2P import/export 和 contributions 的唯一 portable contract。'
    }

    webFrame = component 'Canvas Web node renderer' {
      description 'sandbox="allow-scripts" iframe；只使用 convax.plugin-host/8 transport。'
    }

    sidecar = component 'verified Tool sidecar' {
      description '从 Host 私有精确快照启动；Tool、generation、service 与 P2P export 共用同一 owner。'
    }

    ownedSkills = artifact 'Plugin-owned Skills' {
      description '与闭包原子发布，通过 leased closure 解析；自身没有隐式 capability。'
    }

    hooks = artifact 'authorized Hook snapshots' {
      description '精确、私有、不可变 legacy 字节；DSH 不加载，保留仅用于恢复和卸载。'
    }

    agentMcp = artifact 'Agent remote MCP declarations' {
      description '已验证声明；当前仅 Host-authenticated loopback 入 DSH，远程 guarded transport/OAuth 由 DSH-native Plugin 提供。'
    }

    uiContributions = artifact 'Host-rendered UI contributions' {
      description 'Canvas node、command、menu、toolbar 和 action 的声明，不含任意 host function。'
    }
  }

  convax = system 'Convax Host' {
    description '拥有 ABI、Catalog、校验、安装、ActiveSet、Main routing、IPC/UI 与通用 authoring tooling。'

    contracts = boundary '代码生成契约' {
      apiCatalog = artifact '@convax/plugin-api Catalog' {
        description 'API id、typed schema、since、audience、grant、availability 与 TSDoc 的唯一来源。'
      }

      sdk = artifact '@convax/plugin-sdk' {
        description '唯一 v8 Manifest、contribution、P2P schema/version 和 bounded value contract。'
      }

      generatedRefs = artifact '生成的 types、validators、clients、Docs 与 Skills' {
        description 'CI 校验确定性和 external-consumer 可用性。'
      }
    }

    renderer = boundary 'Electron Renderer' {
      marketplaceUi = component 'Marketplace 与 Capability UI' {
        description '显示 Host 投影并提交 id/用户意图，不提交 URL、digest、principal 或可执行路径。'
      }

      canvasShell = component 'Canvas contribution shell' {
        description '从 validated contributions 投影 node、menu、toolbar、command 和 action。'
      }

      webTransport = component 'Web MessagePort transport' {
        description '只翻译 convax.plugin-host/8 envelope；不实现权限、领域逻辑或 provider 选择。'
      }
    }

    preload = boundary 'Preload transport' {
      description '只暴露固定 convax.plugin-capability/3 client 与可克隆结构。'
    }

    main = boundary 'Electron Main' {
      marketplace = component 'Marketplace validator 与 installer' {
        description '验证 package/2、plugin/8、大小、摘要、safe ZIP、target 和 source identity。'
      }

      closurePublisher = component 'immutable closure publisher' {
        description '原子发布 package、owned Skills、Hook、companion 与授权绑定。'
      }

      activeSet = component 'ActivePluginSet runtime' {
        description '一次全局 CAS 切换 exact snapshots；提供 invocation lease、owner pin 和保守 GC。'
      }

      hostRouter = component 'Main Host API router' {
        description '重检 exact principal、Catalog declaration、grant、availability、scope、revision 与取消。'
      }

      p2pBroker = component 'Host-mediated P2P broker' {
        description '绑定 import/export、SemVer、schema、exact caller/provider pair lease、深度与并发。'
      }

      sidecarOwner = component 'verified sidecar owner' {
        description '唯一 Tool/generation/service/P2P executor；无 shell、无外部可执行回退、无具体 id 分支。'
      }

      agentConfig = component 'Agent configuration bridge' {
        description '注入 leased Skills、authorized Hooks、native remote MCP 和 Host Tool providers。'
      }

      governance = component 'Plugin-to-Host change gate' {
        description '缺失 API 只能形成结构化请求；只有人类批准后才创建独立 Host 任务。'
      }
    }

    canvas = service 'Canvas application services' {
      description '权威命令、业务操作、expectedRevision、单次 CAS 与最终 beforeCommit guard。'
    }

    project = service 'Project services' {
      description 'Project binding、Canvas catalog、资源准入、no-clobber publish 与受保护持久化。'
    }

    agent = service 'Agent runtime' {
      description '通用会话、Skill、Hook、native MCP/OAuth 与 typed Host Tool bridge。'
    }

    hostState = boundary 'Electron userData authority' {
      closures = storage 'immutable Plugin closures'
      descriptors = storage 'validated snapshot descriptors'
      activeSets = storage 'ActiveSets、active pointer 与 owner pins'
      artifactCache = storage '非权威 artifact cache'
    }

    projectState = storage 'Project portable state' {
      description 'Canvas catalog/document 与 admitted resources；只由 Project/Canvas owner 写入。'
    }
  }

  pluginAuthor -> pluginSource.package '实现 contributions 与公开 API 调用'
  convax.contracts.generatedRefs -> pluginSource.generatedSkill '生成 authoring reference'
  pluginAuthor -> registry '发布 Registry metadata'
  pluginAuthor -> releases '发布不可变 package 与 companion'
  registry -> releases '绑定 URL、大小与摘要'
  pluginAuthor -> pluginSource.hostRequest '发现缺失 Host capability'
  pluginSource.hostRequest -> convax.main.governance '提交等待人类判断'
  hostMaintainer -> convax.main.governance '批准、拒绝或指向已有 API'
  hostMaintainer -> convax.contracts.apiCatalog '批准后维护通用 API contract'
  convax.contracts.apiCatalog -> convax.contracts.sdk '提供生成 metadata'
  convax.contracts.apiCatalog -> convax.contracts.generatedRefs '生成 types、validators、Docs 与 Skill'
  convax.contracts.sdk -> convax.contracts.generatedRefs '生成 Manifest/P2P reference'

  user -> convax.renderer.marketplaceUi '安装、更新、启停或移除'
  user -> convax.renderer.canvasShell '使用 Plugin contributions'
  user -> convax.agent '运行 Skill 与 Agent Tool'
  convax.renderer.marketplaceUi -> convax.preload '传输用户意图'
  convax.preload -> convax.main.marketplace '可信 IPC'
  convax.main.marketplace -> registry '读取并验证 Registry'
  convax.main.marketplace -> releases '下载并校验 artifact bytes'
  convax.main.marketplace -> convax.hostState.artifactCache '写入可丢弃缓存'
  convax.main.marketplace -> convax.main.closurePublisher '提交验证后的完整候选'
  convax.main.closurePublisher -> convax.hostState.closures '发布 content-addressed closure'
  convax.main.closurePublisher -> convax.hostState.descriptors '发布 validated descriptor'
  convax.main.closurePublisher -> convax.main.activeSet '请求全局 CAS'
  convax.main.activeSet -> convax.hostState.activeSets '持久化 pointer、set 与 pins'
  convax.main.activeSet -> pluginRuntime.manifest '租赁 exact snapshot'
  convax.main.activeSet -> pluginRuntime.ownedSkills '从 closure 直接解析'
  convax.main.activeSet -> pluginRuntime.hooks '解析 authorized exact bytes'
  convax.main.activeSet -> pluginRuntime.sidecar '绑定 managed companion bytes'

  convax.renderer.canvasShell -> convax.renderer.webTransport '挂载 validated Web contribution'
  convax.renderer.webTransport -> pluginRuntime.webFrame '建立每 frame 独立 MessagePort'
  pluginRuntime.webFrame -> convax.renderer.webTransport '发送 host/8 request'
  convax.renderer.webTransport -> convax.preload '纯 transport translation'
  convax.preload -> convax.main.hostRouter 'capability/3 exact sender connection'
  convax.main.hostRouter -> convax.main.activeSet '签发并重检 exact principal/lease'
  convax.main.hostRouter -> convax.canvas '执行 Canvas command/query'
  convax.main.hostRouter -> convax.project '执行 Project capability'
  convax.main.hostRouter -> convax.agent '执行 Agent capability'
  convax.main.hostRouter -> convax.main.sidecarOwner '执行 Tool capability'

  pluginRuntime.manifest -> convax.main.p2pBroker '提供 versioned import/export declarations'
  convax.main.p2pBroker -> convax.main.activeSet '联合租赁 exact caller/provider'
  convax.main.p2pBroker -> convax.main.sidecarOwner '以 provider principal 执行 export'
  convax.main.sidecarOwner -> pluginRuntime.sidecar '调用同一 verified process generation'
  pluginRuntime.sidecar -> convax.main.p2pBroker '发起受限 nested import'
  pluginRuntime.sidecar -> convax.main.hostRouter '使用 invocation-scoped reverse Host authority'
  pluginRuntime.sidecar -> externalService '持有集成语义、凭据与网络调用'

  pluginRuntime.uiContributions -> convax.renderer.canvasShell '投影 Host-rendered surfaces'
  pluginRuntime.ownedSkills -> convax.main.agentConfig '提供 leased Skill paths'
  pluginRuntime.hooks -> convax.main.agentConfig '提供 immutable file URLs'
  pluginRuntime.agentMcp -> convax.main.agentConfig '提供 validated native MCP config'
  convax.main.agentConfig -> convax.agent '注入通用配置'
  convax.agent -> convax.canvas '调用 typed Host tools'
  convax.agent -> convax.main.sidecarOwner '复用同一 Tool executor'

  convax.main.sidecarOwner -> convax.project '暂存输入并发布验证后的输出'
  convax.main.sidecarOwner -> convax.canvas '提交领域 mutation'
  convax.canvas -> convax.project '通过 typed port 持久化'
  convax.project -> convax.projectState '读写受保护 portable state'
}

deployment {
  workstation = device '用户工作站' {
    mainProcess = process 'Electron Main' {
      instanceOf convax.main.marketplace
      instanceOf convax.main.closurePublisher
      instanceOf convax.main.activeSet
      instanceOf convax.main.hostRouter
      instanceOf convax.main.p2pBroker
      instanceOf convax.main.sidecarOwner
      instanceOf convax.main.agentConfig
      instanceOf convax.main.governance
      instanceOf convax.canvas
      instanceOf convax.project
    }

    rendererProcess = process 'Electron Renderer' {
      instanceOf convax.renderer.marketplaceUi
      instanceOf convax.renderer.canvasShell
      instanceOf convax.renderer.webTransport
      instanceOf convax.preload
    }

    webSandbox = sandbox 'sandboxed Plugin iframe' {
      instanceOf pluginRuntime.webFrame
    }

    sidecarProcess = process 'verified sidecar process generation' {
      instanceOf pluginRuntime.sidecar
    }

    agentProcess = process 'Project-isolated DSH utility process' {
      instanceOf convax.agent
      instanceOf pluginRuntime.ownedSkills
      instanceOf pluginRuntime.agentMcp
    }

    userData = data 'Electron userData' {
      instanceOf convax.hostState.closures
      instanceOf convax.hostState.descriptors
      instanceOf convax.hostState.activeSets
      instanceOf convax.hostState.artifactCache
    }

    projectRoot = data '绑定的 Project root' {
      instanceOf convax.projectState
    }
  }

  internet = network '外部网络域' {
    instanceOf registry
    instanceOf releases
    instanceOf externalService
  }
}

views {
  view index {
    title 'Convax v8 插件平台总览'
    description '唯一 v8 Manifest、Main authority、immutable ActiveSet、Plugin contributions 与外部边界。'
    include *
  }

  view runtime_contracts {
    title '运行契约与生成 reference'
    description 'plugin/8、host/8、capability/3 与独立 SemVer Host API Catalog。'
    include
      pluginAuthor,
      hostMaintainer,
      pluginSource.*,
      pluginRuntime.manifest,
      convax.contracts.*,
      convax.renderer.webTransport,
      convax.preload,
      convax.main.hostRouter,
      convax.main.governance
  }

  view contribution_planes {
    title '声明式贡献平面'
    description 'Skill、MCP、Agent、Tool、node、menu、toolbar 与 action 不相互继承权限。'
    include
      user,
      pluginRuntime.*,
      convax.renderer.canvasShell,
      convax.renderer.webTransport,
      convax.main.hostRouter,
      convax.main.sidecarOwner,
      convax.main.agentConfig,
      convax.canvas,
      convax.project,
      convax.agent,
      externalService
  }

  view authority_and_execution {
    title 'Main authority 与执行所有权'
    description 'Renderer transport 汇聚到 Main router；领域服务和 verified sidecar 保持单一 owner。'
    include
      user,
      pluginRuntime.webFrame,
      pluginRuntime.sidecar,
      convax.renderer.*,
      convax.preload,
      convax.main.activeSet,
      convax.main.hostRouter,
      convax.main.sidecarOwner,
      convax.canvas,
      convax.project,
      convax.agent,
      convax.projectState
  }

  view p2p_broker {
    title 'Plugin-to-Plugin typed broker'
    description 'Host 绑定 exact caller/provider lease、version/schema、取消、深度、并发和嵌套调用。'
    include
      pluginRuntime.manifest,
      pluginRuntime.sidecar,
      convax.main.activeSet,
      convax.main.p2pBroker,
      convax.main.sidecarOwner,
      convax.main.hostRouter
  }

  deployment view process_trust_boundaries {
    title '进程、沙箱与数据边界'
    description 'Web 无 authority；Main 持有策略；sidecar 执行精确字节；DSH/Cordis Plugin 组合 Agent 机制。'
    includeAncestors: true
    include workstation.**, internet.**
  }

  dynamic view installation_flow {
    title '完整闭包发布与 ActiveSet CAS'
    description '验证 package/8 contributions 后发布 closure，再以一次 CAS 改变全局可见集合。'
    user -> convax.renderer.marketplaceUi '选择安装或更新'
    convax.renderer.marketplaceUi -> convax.preload '提交 id 与用户意图'
    convax.preload -> convax.main.marketplace '可信 IPC'
    convax.main.marketplace -> registry '验证 source identity 与 version'
    convax.main.marketplace -> releases '验证大小、摘要、target 与 ZIP'
    convax.main.marketplace -> convax.main.closurePublisher '提交 complete candidate'
    convax.main.closurePublisher -> convax.hostState.closures '发布 immutable bytes'
    convax.main.closurePublisher -> convax.hostState.descriptors '发布 validated descriptor'
    convax.main.closurePublisher -> convax.main.activeSet 'compare-and-swap complete set'
    convax.main.activeSet -> convax.hostState.activeSets '持久化 exact set/pointer'
  }

  dynamic view web_host_call {
    title 'Web Plugin Host API 调用'
    description 'host/8 和 capability/3 都是 transport；Main 是唯一 authority 和业务路由。'
    user -> pluginRuntime.webFrame '显式触发操作'
    pluginRuntime.webFrame -> convax.renderer.webTransport 'host/8 request'
    convax.renderer.webTransport -> convax.preload 'transport-only translation'
    convax.preload -> convax.main.hostRouter 'capability/3 sender-bound call'
    convax.main.hostRouter -> convax.main.activeSet '验证 exact principal 与 lease'
    convax.main.hostRouter -> convax.canvas '执行 typed command/query'
    convax.canvas -> convax.project 'CAS / no-clobber persistence'
    convax.main.hostRouter -> pluginRuntime.webFrame '返回有界 pathless result'
  }

  dynamic view plugin_host_request {
    title 'Plugin 缺失 Host API 的治理流程'
    description 'Plugin task 不修改 Host；结构化诉求必须等待人类决定。'
    pluginAuthor -> pluginSource.hostRequest '记录 use case、contract、替代方案与 tests'
    pluginSource.hostRequest -> convax.main.governance '提交请求并停止 Host 修改'
    hostMaintainer -> convax.main.governance '人类批准、拒绝或指向已有 API'
    convax.main.governance -> convax.contracts.apiCatalog '批准后创建独立 Host task'
    convax.contracts.apiCatalog -> convax.contracts.generatedRefs '生成 types、Docs 与 Skill reference'
    convax.contracts.generatedRefs -> pluginSource.generatedSkill '发布 authoring contract'
  }
}
